{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\build\\cpp\\task-cpp.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "TASKMAN_DB",
          "value": "${workspaceFolder}/data/tasks.db"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\Users\\reyes\\AppData\\Local\\Microsoft\\WinGet\\Packages\\BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build C++"
    },
    {
      "name": "Java: Debug",
      "type": "java",
      "request": "launch",
      "mainClass": "Main",
      "cwd": "${workspaceFolder}",
      "env": {
        "TASKMAN_DB": "${workspaceFolder}/data/tasks.db"
      },
      "console": "integratedTerminal"
    }
  ]
}
